    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "16.4.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "8.5.25",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "vitest": "^4.1.11"
