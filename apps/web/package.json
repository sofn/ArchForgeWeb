    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "highlight.js": "11.11.1",
    "lucide-react": "1.28.0",
    "next": "16.2.12",
    "next-intl": "4.13.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
